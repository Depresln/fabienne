{% extends 'base.html.twig' %}

{% block title %}Importer les photos{% endblock %}

{% block body %}
    <main class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
        <a href="{{ path('home') }}" class="text-sm font-medium text-sky-700 hover:text-sky-900">← Retour au site</a>
        <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h1 class="text-2xl font-semibold text-slate-900">Importer les photos dans le volume</h1>
            <p class="mt-3 text-slate-600">Cette action copie les fichiers versionnés dans <code>uploads-source</code> vers <code>public/uploads</code>, qui est le volume Railway. Les fichiers déjà présents ne sont jamais écrasés, tu peux donc relancer l’import sans risque.</p>

            {% for message in app.flashes('success') %}
                <p class="mt-5 rounded-lg bg-emerald-50 px-4 py-3 text-emerald-800">{{ message }}</p>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <p class="mt-5 rounded-lg bg-red-50 px-4 py-3 text-red-800">{{ message }}</p>
            {% endfor %}

            {% if not sourceExists %}
                <p class="mt-5 rounded-lg bg-amber-50 px-4 py-3 text-amber-800">Le dossier source <code>uploads-source</code> n’est pas disponible dans ce déploiement.</p>
            {% elseif not destinationMounted %}
                <p class="mt-5 rounded-lg bg-amber-50 px-4 py-3 text-amber-800">Le volume n’est pas monté sur <code>/app/public/uploads</code>.</p>
            {% else %}
                <form method="post" class="mt-6">
                    <input type="hidden" name="_token" value="{{ csrf_token('import_uploads') }}">
                    <button type="submit" class="rounded-lg bg-sky-700 px-5 py-3 font-semibold text-white transition hover:bg-sky-800">Copier les photos maintenant</button>
                </form>
            {% endif %}
        </section>
    </main>
{% endblock %}