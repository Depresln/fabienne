{% extends 'base.html.twig' %}

{% block title %}{{ post.title }} — Fabienne Depresles{% endblock %}

{% block body %}
    <article>
        <header class="bg-flower-50">
            <div class="mx-auto max-w-5xl px-5 py-14 text-center lg:px-8 lg:py-20">
                <a href="{{ path('home') }}" class="text-sm font-bold uppercase tracking-[0.2em] text-flower-700">← Retour au journal</a>
                <h1 class="mt-5 font-display text-6xl leading-none text-flower-900 sm:text-7xl">{{ post.title }}</h1>
                <p class="mt-5 text-sm font-medium text-slate-500">
                    {% if post.createdAt == post.modifiedAt %}Publié le {{ post.createdAt|date('d.m.Y') }} à {{ post.createdAt|date('H:i') }}{% else %}Mis à jour le {{ post.modifiedAt|date('d.m.Y') }} à {{ post.modifiedAt|date('H:i') }}{% endif %}
                    <span class="mx-2 text-flower-300">•</span>{{ post.viewCount }} {{ post.viewCount > 1 ? 'vues' : 'vue' }}
                </p>
            </div>
        </header>

        <div class="mx-auto max-w-6xl px-5 py-12 lg:px-8 lg:py-16">
            {% for medium in post.media %}
                {% if loop.first %}
                    <figure>
                        <a href="{{ asset('uploads/' ~ medium.path) }}" data-lightbox data-media-view-url="{{ path('media_view', {'id': medium.id}) }}" data-media-view-count="media-view-count-{{ medium.id }}" class="block overflow-hidden rounded-xl bg-flower-100">
                            <img src="{{ asset('uploads/' ~ medium.path) }}" class="max-h-[70vh] w-full object-contain" alt="{{ post.title }} — vue principale">
                        </a>
                        <figcaption class="mt-2 text-xs font-semibold text-slate-500"><span id="media-view-count-{{ medium.id }}">{{ medium.viewCount }}</span> {{ medium.viewCount > 1 ? 'vues' : 'vue' }}</figcaption>
                        {% if app.user %}
                            <div class="mt-3 flex justify-end">
                                <button type="button" data-dialog-open="delete-image-{{ medium.id }}" class="button-danger">Supprimer cette image</button>
                            </div>
                            {{ include('partials/_modalPostImg.html.twig') }}
                        {% endif %}
                    </figure>
                {% endif %}
            {% endfor %}

            <div class="mx-auto max-w-3xl py-12 text-lg leading-8 text-slate-700">{{ post.description|nl2br }}</div>

            {% if post.media|length > 1 %}
                <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                    {% for medium in post.media[1:] %}
                        <figure>
                            <a href="{{ asset('uploads/' ~ medium.path) }}" data-lightbox data-media-view-url="{{ path('media_view', {'id': medium.id}) }}" data-media-view-count="media-view-count-{{ medium.id }}" class="block overflow-hidden rounded-xl bg-flower-100">
                                <img src="{{ asset('uploads/' ~ medium.path) }}" class="aspect-square w-full object-cover transition-transform duration-300 hover:scale-[1.02]" loading="lazy" alt="{{ post.title }} — détail {{ loop.index }}">
                            </a>
                            <figcaption class="mt-2 text-xs font-semibold text-slate-500"><span id="media-view-count-{{ medium.id }}">{{ medium.viewCount }}</span> {{ medium.viewCount > 1 ? 'vues' : 'vue' }}</figcaption>
                            {% if app.user %}
                                <button type="button" data-dialog-open="delete-image-{{ medium.id }}" class="mt-3 w-full button-danger">Supprimer cette image</button>
                                {{ include('partials/_modalPostImg.html.twig') }}
                            {% endif %}
                        </figure>
                    {% endfor %}
                </div>
            {% endif %}

            <section class="mx-auto mt-16 max-w-3xl border-t border-flower-100 pt-10" aria-labelledby="comments-title">
                <div class="flex items-end justify-between gap-4">
                    <div>
                        <p class="text-sm font-bold uppercase tracking-[0.2em] text-flower-700">Vos mots</p>
                        <h2 id="comments-title" class="mt-2 font-display text-4xl text-flower-900">Commentaires</h2>
                    </div>
                    {% if app.user %}<span class="rounded-full bg-flower-100 px-3 py-1 text-xs font-bold text-flower-800">Vue administration</span>{% endif %}
                </div>

                {% for message in app.flashes('success') %}
                    <div class="mt-6 border-l-4 border-emerald-600 bg-emerald-50 p-4 text-sm text-emerald-900" role="status">{{ message }}</div>
                {% endfor %}

                <div class="mt-7 space-y-4">
                    {% set hasComments = false %}
                    {% for comment in post.comments %}
                        {% if app.user or comment.approved %}
                            {% set hasComments = true %}
                            <article class="rounded-xl border p-5 {{ not comment.approved ? 'border-blue-300 bg-blue-50' : 'border-flower-200 bg-white' }}">
                                <div class="flex flex-wrap items-start justify-between gap-3">
                                    <div>
                                        <p class="font-bold text-ink">{{ comment.name }}</p>
                                        <p class="mt-1 text-xs font-medium text-slate-500">{{ comment.createdAt|date('d.m.Y à H:i') }}</p>
                                    </div>
                                    {% if app.user and not comment.approved %}<span class="rounded-full bg-blue-600 px-3 py-1 text-xs font-bold text-white">Nouveau commentaire</span>{% endif %}
                                </div>
                                <p class="mt-4 whitespace-pre-line leading-7 text-slate-700">{{ comment.message }}</p>
                                {% if app.user %}
                                    <div class="mt-5 flex flex-wrap gap-3 border-t border-blue-200/70 pt-4">
                                        {% if not comment.approved %}
                                            <form method="post" action="{{ path('approve_comment', {'id': comment.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('approve-comment-' ~ comment.id) }}">
                                                <button class="button-primary" type="submit">Valider</button>
                                            </form>
                                        {% endif %}
                                        <form method="post" action="{{ path('delete_comment', {'id': comment.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete-comment-' ~ comment.id) }}">
                                            <button class="button-danger" type="submit">Supprimer</button>
                                        </form>
                                    </div>
                                {% endif %}
                            </article>
                        {% endif %}
                    {% endfor %}
                    {% if not hasComments %}<p class="rounded-xl bg-flower-50 p-5 text-sm text-slate-600">Soyez le premier à laisser un commentaire.</p>{% endif %}
                </div>

                <div class="mt-10 rounded-xl bg-flower-50 p-6 sm:p-8">
                    <h3 class="text-xl font-bold text-ink">Laisser un commentaire</h3>
                    <p class="mt-2 text-sm text-slate-600">Votre message sera publié après validation.</p>
                    {{ form_start(comment_form, {'attr': {'class': 'mt-6 space-y-5'}}) }}
                        <div>
                            {{ form_label(comment_form.name, null, {'label_attr': {'class': 'field-label'}}) }}
                            {{ form_widget(comment_form.name, {'attr': {'class': 'field-control', 'autocomplete': 'name'}}) }}
                            <div class="field-errors">{{ form_errors(comment_form.name) }}</div>
                        </div>
                        <div>
                            {{ form_label(comment_form.message, null, {'label_attr': {'class': 'field-label'}}) }}
                            {{ form_widget(comment_form.message, {'attr': {'class': 'field-control min-h-32'}}) }}
                            <div class="field-errors">{{ form_errors(comment_form.message) }}</div>
                        </div>
                        {{ form_widget(comment_form.submit, {'attr': {'class': 'button-primary'}}) }}
                    {{ form_end(comment_form) }}
                </div>
            </section>

            <footer class="mt-14 flex flex-wrap justify-center gap-3 border-t border-flower-100 pt-8">
                {% if app.user %}
                    <button type="button" data-dialog-open="delete-post-{{ post.id }}" class="button-danger">Supprimer l'article</button>
                    {{ include('partials/_modalPostFull.html.twig') }}
                    <a href="{{ path('edit', {'id': post.id}) }}" class="button-secondary">Éditer</a>
                {% endif %}
                <a href="{{ path('home') }}" class="button-primary">Retour à l'accueil</a>
            </footer>
        </div>
    </article>
{% endblock %}
