{% extends 'base.html.twig' %}

{% block title %}Commentaires — Administration{% endblock %}

{% block body %}
    <section class="min-h-[calc(100vh-5rem)] bg-flower-50 px-5 py-12 lg:px-8 lg:py-16">
        <div class="mx-auto max-w-5xl">
            <p class="text-sm font-bold uppercase tracking-[0.2em] text-flower-700">Administration</p>
            <div class="mt-2 flex flex-wrap items-end justify-between gap-5">
                <div>
                    <h1 class="font-display text-5xl text-flower-900 sm:text-6xl">Commentaires</h1>
                    <p class="mt-3 text-slate-600">Les commentaires en attente apparaissent en bleu.</p>
                </div>
                <a href="{{ path('home') }}" class="button-secondary">Retour au site</a>
            </div>

            {% for message in app.flashes('success') %}
                <div class="mt-8 border-l-4 border-emerald-600 bg-emerald-50 p-4 text-emerald-900" role="status">{{ message }}</div>
            {% endfor %}

            <div class="mt-8 space-y-5">
                {% for comment in comments %}
                    <article class="rounded-xl border p-6 sm:p-7 {{ not comment.approved ? 'border-blue-300 bg-blue-50' : 'border-flower-200 bg-white' }}">
                        <div class="flex flex-wrap items-start justify-between gap-5">
                            <div>
                                <p class="font-bold text-ink">{{ comment.name }}</p>
                                <p class="mt-1 text-sm text-slate-500">{{ comment.createdAt|date('d.m.Y à H:i') }}</p>
                            </div>
                            {% if not comment.approved %}<span class="rounded-full bg-blue-600 px-3 py-1 text-xs font-bold text-white">À valider</span>{% else %}<span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800">Publié</span>{% endif %}
                        </div>

                        <p class="mt-5 whitespace-pre-line leading-7 text-slate-700">{{ comment.message }}</p>
                        <div class="mt-6 flex flex-wrap items-center gap-3 border-t border-flower-200 pt-5">
                            <a href="{{ path('blog', {'id': comment.post.id}) }}" class="button-secondary">Voir l’article : {{ comment.post.title }}</a>
                            {% if not comment.approved %}
                                <form method="post" action="{{ path('approve_comment', {'id': comment.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('approve-comment-' ~ comment.id) }}">
                                    <input type="hidden" name="return_to" value="comments">
                                    <button class="button-primary" type="submit">Valider</button>
                                </form>
                            {% endif %}
                            <form method="post" action="{{ path('delete_comment', {'id': comment.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-comment-' ~ comment.id) }}">
                                <input type="hidden" name="return_to" value="comments">
                                <button class="button-danger" type="submit">Refuser et supprimer</button>
                            </form>
                        </div>
                    </article>
                {% else %}
                    <div class="rounded-xl border border-dashed border-flower-300 bg-white p-10 text-center text-slate-600">Aucun commentaire pour le moment.</div>
                {% endfor %}
            </div>
            <div class="mt-10">{{ knp_pagination_render(comments) }}</div>
        </div>
    </section>
{% endblock %}
