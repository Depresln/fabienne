{% extends 'base.html.twig' %}

{% block title %}Fabienne Depresles — Art floral en Alsace{% endblock %}

{% block body %}
    <section class="relative isolate flex min-h-[34rem] items-end overflow-hidden bg-white">
        <img src="{{ asset('images/logoeditt.jpg') }}" alt="Composition florale de Fabienne" class="absolute inset-0 -z-10 size-full object-contain object-center opacity-70">
        <div class="mx-auto w-full max-w-7xl px-5 pb-16 pt-32 lg:px-8 lg:pb-24">
            <p class="mb-4 text-sm font-bold uppercase tracking-[0.24em] text-flower-700">Créations & transmission</p>
            <h1 class="max-w-4xl font-display text-6xl leading-[0.9] text-flower-900 sm:text-7xl lg:text-8xl">L'art floral de Fabienne</h1>
        </div>
    </section>

    <section id="ateliers" class="scroll-mt-24 bg-flower-50">
        <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 lg:grid-cols-[0.7fr_1.3fr] lg:px-8 lg:py-20">
            <div>
                <p class="text-sm font-bold uppercase tracking-[0.2em] text-flower-700">Les ateliers</p>
                <h2 class="mt-3 font-display text-5xl leading-none text-flower-900">Une passion devenue atelier</h2>
            </div>
            <div class="border-l-4 border-flower-400 pl-6 text-lg leading-8 text-slate-700 sm:pl-8">
                {% if contenu %}
                    {{ contenu.text|nl2br }}
                {% else %}
                    <p>Ancienne élève de Violette Soret, animatrice et juge de divers concours d’art floral en Île-de-France.</p>
                    <p class="mt-5">J’ai ouvert mon atelier à Grandfontaine, en Alsace, en novembre 2019 avec le désir de faire connaître l’art floral occidental. J’anime une fois par mois un atelier associatif bénévole pour transmettre cette discipline.</p>
                {% endif %}
            </div>
            {% if app.user %}
                <div class="lg:col-span-2">
                    <a href="{{ path('edit_home_content') }}" class="button-secondary">Modifier le message d’accueil</a>
                </div>
            {% endif %}
        </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-14 lg:px-8 lg:py-20">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
            <div>
                <p class="text-sm font-bold uppercase tracking-[0.2em] text-flower-700">Le journal de l'atelier</p>
                <h2 class="mt-2 font-display text-5xl text-flower-900 sm:text-6xl">Dernières créations</h2>
            </div>
            <a href="{{ path('gallery') }}" class="button-secondary">Voir toute la galerie</a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="mb-8 border-l-4 border-emerald-600 bg-emerald-50 p-4 text-emerald-900" role="status">{{ message }}</div>
        {% endfor %}

        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {% for post in posts %}
                <article class="group flex h-full flex-col overflow-hidden rounded-xl border border-flower-200 bg-white transition-colors hover:border-flower-600">
                    <a href="{{ path('blog', {'id': post.id}) }}" class="flex h-full flex-col">
                        {% for medium in post.media %}
                            {% if loop.first %}<img src="{{ asset('uploads/' ~ medium.path) }}" class="aspect-[4/3] w-full bg-flower-100 object-cover" loading="lazy" alt="Illustration de {{ post.title }}">{% endif %}
                        {% else %}
                            <div class="grid aspect-[4/3] place-items-center bg-flower-100 text-flower-700">Création florale</div>
                        {% endfor %}
                        <div class="flex flex-1 flex-col p-6">
                            <h3 class="text-xl font-bold text-ink group-hover:text-flower-700">{{ post.title }}</h3>
                            <p class="mt-3 line-clamp-4 text-sm leading-6 text-slate-600">{{ post.description|length > 220 ? post.description|slice(0, 220) ~ '…' : post.description }}</p>
                            <div class="mt-auto flex items-end justify-between gap-4 pt-6 text-xs font-semibold text-slate-500">
                                <span>{% if post.createdAt == post.modifiedAt %}{{ post.createdAt|date('d.m.Y') }}{% else %}{{ post.modifiedAt|date('d.m.Y') }} · édité{% endif %} · {{ post.viewCount }} {{ post.viewCount > 1 ? 'vues' : 'vue' }}</span>
                                <span class="text-flower-700">Découvrir →</span>
                            </div>
                        </div>
                    </a>
                </article>
            {% else %}
                <div class="col-span-full border border-dashed border-flower-300 bg-flower-50 p-10 text-center text-slate-600">Les prochaines créations seront bientôt publiées.</div>
            {% endfor %}
        </div>
        <div class="mt-12">{{ knp_pagination_render(posts) }}</div>
    </section>
{% endblock %}
