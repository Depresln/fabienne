{% extends 'base.html.twig' %}

{% block title %}Publier — Fabienne Depresles{% endblock %}

{% block body %}
    <section class="min-h-[calc(100vh-5rem)] bg-flower-50 px-5 py-12 lg:px-8 lg:py-16">
        {% if app.user %}
            <div class="mx-auto max-w-3xl rounded-xl border border-flower-200 bg-white p-6 sm:p-10">
                <p class="text-sm font-bold uppercase tracking-[0.2em] text-flower-700">Administration</p>
                <h1 class="mt-2 font-display text-5xl text-flower-900 sm:text-6xl">Publier une création</h1>
                <p class="mt-3 text-slate-600">Ajoutez un titre, un texte et une ou plusieurs photographies.</p>

                {% for message in app.flashes('danger') %}
                    <div class="mt-6 border-l-4 border-red-700 bg-red-50 p-4 text-red-900" role="alert">{{ message }}</div>
                {% endfor %}

                {{ form_start(post_form, {'attr': {'class': 'mt-8 space-y-6'}}) }}
                    <div>
                        {{ form_label(post_form.title, 'Titre', {'label_attr': {'class': 'field-label'}}) }}
                        {{ form_widget(post_form.title, {'attr': {'class': 'field-control', 'placeholder': 'Titre de la publication'}}) }}
                        <div class="field-errors">{{ form_errors(post_form.title) }}</div>
                    </div>
                    <div>
                        {{ form_label(post_form.description, 'Description', {'label_attr': {'class': 'field-label'}}) }}
                        {{ form_widget(post_form.description, {'attr': {'class': 'field-control min-h-48', 'placeholder': 'Racontez cette création…'}}) }}
                        <div class="field-errors">{{ form_errors(post_form.description) }}</div>
                    </div>
                    <div>
                        {{ form_label(post_form.media, 'Photographies', {'label_attr': {'class': 'field-label'}}) }}
                        {{ form_widget(post_form.media, {'attr': {'class': 'field-control file:mr-4 file:rounded-md file:border-0 file:bg-flower-100 file:px-4 file:py-2 file:font-semibold file:text-flower-800'}}) }}
                        <div class="field-errors">{{ form_errors(post_form.media) }}</div>
                    </div>
                    {{ form_widget(post_form.send, {'label': 'Publier', 'attr': {'class': 'button-primary'}}) }}
                {{ form_end(post_form) }}

                <div class="mt-8 border-t border-flower-100 pt-6"><a href="{{ path('home') }}" class="button-secondary">Retour à l'accueil</a></div>
            </div>
        {% endif %}
    </section>
{% endblock %}
