{% extends 'base.html.twig' %}

{% block title %}Galerie — Fabienne Depresles{% endblock %}

{% block body %}
    <header class="bg-flower-800 text-white">
        <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-20">
            <p class="text-sm font-bold uppercase tracking-[0.22em] text-flower-200">Compositions & détails</p>
            <h1 class="mt-3 font-display text-6xl leading-none sm:text-7xl">Galerie</h1>
        </div>
    </header>

    <section class="mx-auto max-w-7xl px-5 py-12 lg:px-8 lg:py-16">
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {% for medium in media %}
                <figure class="group">
                    <a href="{{ asset('uploads/' ~ medium.path) }}" data-lightbox data-media-view-url="{{ path('media_view', {'id': medium.id}) }}" data-media-view-count="media-view-count-{{ medium.id }}" class="block overflow-hidden rounded-xl bg-flower-100">
                        <img src="{{ asset('uploads/' ~ medium.path) }}" class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" loading="lazy" alt="Composition florale {{ loop.index }}">
                    </a>
                    <figcaption class="mt-2 text-xs font-semibold text-slate-500"><span id="media-view-count-{{ medium.id }}">{{ medium.viewCount }}</span> {{ medium.viewCount > 1 ? 'vues' : 'vue' }}</figcaption>
                    {% if app.user %}
                        <button type="button" data-dialog-open="delete-gallery-image-{{ medium.id }}" class="mt-3 w-full button-danger">Supprimer</button>
                        {{ include('partials/_modalGallery.html.twig') }}
                    {% endif %}
                </figure>
            {% else %}
                <div class="col-span-full border border-dashed border-flower-300 bg-flower-50 p-12 text-center text-slate-600">La galerie sera bientôt enrichie de nouvelles créations.</div>
            {% endfor %}
        </div>
        <div class="mt-12">{{ knp_pagination_render(media) }}</div>
    </section>
{% endblock %}
