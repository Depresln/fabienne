<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="Découvrez l'art floral occidental et les créations de Fabienne Depresles en Alsace.">
        <title>{% block title %}Fabienne Depresles — Art floral{% endblock %}</title>
        <link rel="icon" type="image/x-icon" href="{{ asset('images/logo.png') }}">
        {% block stylesheets %}{{ encore_entry_link_tags('app') }}{% endblock %}
        {% block javascripts %}{{ encore_entry_script_tags('app') }}{% endblock %}
    </head>
    <body>
        {{ include('partials/_navbar.html.twig') }}
        <main>{% block body %}{% endblock %}</main>
        {{ include('partials/_footer.html.twig') }}

        <dialog id="image-lightbox" class="m-auto max-h-[92vh] w-[min(92vw,72rem)] bg-transparent p-0 backdrop:bg-slate-950/80">
            <div class="relative flex max-h-[92vh] items-center justify-center bg-slate-950 p-3 sm:p-5">
                <button type="button" data-dialog-close class="absolute right-4 top-4 z-10 grid size-11 place-items-center rounded-lg bg-white text-2xl leading-none text-slate-900" aria-label="Fermer l'image">&times;</button>
                <img src="" alt="" class="max-h-[86vh] w-auto max-w-full object-contain">
            </div>
        </dialog>
    </body>
</html>
