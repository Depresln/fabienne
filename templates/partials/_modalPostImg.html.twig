<dialog id="delete-image-{{ medium.id }}" class="m-auto w-[min(92vw,30rem)] rounded-xl border-0 bg-white p-0 backdrop:bg-slate-950/55">
    <div class="p-6 sm:p-8">
        <div class="flex items-start justify-between gap-5">
            <div>
                <p class="text-sm font-bold uppercase tracking-[0.18em] text-red-700">Confirmation</p>
                <h2 class="mt-2 text-2xl font-bold text-ink">Supprimer cette image ?</h2>
                <p class="mt-3 text-sm leading-6 text-slate-600">Cette action est définitive.</p>
            </div>
            <button type="button" data-dialog-close class="grid size-10 shrink-0 place-items-center rounded-lg bg-slate-100 text-2xl" aria-label="Fermer">&times;</button>
        </div>
        <div class="mt-8 flex justify-end gap-3">
            <button type="button" data-dialog-close class="button-secondary">Annuler</button>
            <a href="{{ path('deleteImg', {'id': medium.id, 'postId': post.id}) }}" class="button-danger">Supprimer</a>
        </div>
    </div>
</dialog>
